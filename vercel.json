{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "app.stiloaipartners.com"
        }
      ],
      "destination": "/app/$1"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "admin.stiloaipartners.com"
        }
      ],
      "destination": "/admin/$1"
    }
  ],
  "redirects": [
    {
      "source": "/dashboard",
      "destination": "/app",
      "permanent": true
    },
    {
      "source": "/dashboard.html",
      "destination": "/app",
      "permanent": true
    },
    {
      "source": "/agents/ai-seo",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/agents/ontology",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/agents/prospecting",
      "destination": "/agents/b2bleadgen",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/prospects/sync-bookings",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/prospects/sync-meetings",
      "schedule": "20 11-23 * * *"
    },
    {
      "path": "/api/prospects/send-confirmations",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/prospects/send-meeting-reminders",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/prospects/sync-scripts",
      "schedule": "40 * * * *"
    },
    {
      "path": "/api/prospects/send-vsl-followup",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/prospects/send-day-before",
      "schedule": "7 * * * *"
    },
    {
      "path": "/api/admin/health-alerts",
      "schedule": "25 * * * *"
    },
    {
      "path": "/api/prospects/sync-meet-transcripts",
      "schedule": "35 * * * *"
    },
    {
      "path": "/api/prospects/enable-meet-transcription",
      "schedule": "50 * * * *"
    },
    {
      "path": "/api/prospects/outbound-tick",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/prospects/schedule-nurture",
      "schedule": "5,35 * * * *"
    },
    {
      "path": "/api/prospects/send-nurture-value",
      "schedule": "*/15 * * * *"
    }
  ],
  "headers": []
}
