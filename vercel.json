{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "app.stiloaipartners.com" }],
      "destination": "/app/$1"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "admin.stiloaipartners.com" }],
      "destination": "/admin/$1"
    }
  ],
  "redirects": [
    {
      "source": "/dashboard",
      "destination": "/app",
      "permanent": true
    },
    {
      "source": "/dashboard.html",
      "destination": "/app",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/prospects/sync-bookings",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/prospects/sync-meetings",
      "schedule": "20 11-23 * * *"
    }
  ],
  "headers": []
}
